# Azure AI Document Intelligence remains key-authenticated for this local demo.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-local-key

# The standard OpenAI SDK calls Azure's OpenAI-compatible v1 endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=replace-with-your-local-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Production-only shared-password gate. Keep AUTH_ENABLED false for local development.
AUTH_ENABLED=false
# APP_PASSWORD=replace-with-a-shared-password
# SESSION_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql+psycopg://invoiceadmin:password@server.postgres.database.azure.com:5432/invoicereview?sslmode=require
# UPLOAD_DIR=/mnt/data/uploads
# FRONTEND_DIST_DIR=/app/frontend-dist
